# Dant काया Multispeciality Clinic — Environment Configuration Example
# Copy this file to .env.local and provide credentials when connecting live webhooks.

# Optional: Webhook URL (e.g., Google Apps Script, CRM endpoint, Slack/WhatsApp webhook, or email relay)
# to receive validated POST /api/appointments requests automatically.
# When unset, appointment requests are validated, assigned a reference ID (DK-APT-...),
# logged on the server, and returned with status="pending_reception_confirmation" and a
# pre-filled WhatsApp confirmation link to +91 89339 32525.
APPOINTMENT_WEBHOOK_URL=

# Optional: Webhook URL to receive validated POST /api/contact general enquiries.
# Falls back to APPOINTMENT_WEBHOOK_URL if unset.
CONTACT_WEBHOOK_URL=
