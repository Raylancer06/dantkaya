# Dant काया Multispeciality Clinic — Environment Configuration
# Copy this file to .env.local and configure your credentials.

# --------------------------------------------------------------------------
# 1. Clinic Email Delivery Configuration (appointment@dantkaya.com)
# --------------------------------------------------------------------------
# Configures SMTP transmission for:
# a) Clinic desk notifications sent to CLINIC_NOTIFICATION_EMAIL (appointment@dantkaya.com)
# b) Reassuring confirmation emails sent to patients / customers.
#
# Common Host Examples:
# - Google Workspace / Gmail: smtp.gmail.com (Port: 465, use 16-character App Password)
# - Hostinger / cPanel: smtp.hostinger.com or mail.dantkaya.com (Port: 465)
# - Zoho Mail: smtppro.zoho.com (Port: 465)
# - AWS SES / Resend SMTP: smtp.resend.com (Port: 465 or 587)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=appointment@dantkaya.com
SMTP_PASS=
SMTP_SECURE=true
SMTP_FROM="Dant काया Multispeciality Clinic" <appointment@dantkaya.com>
CLINIC_NOTIFICATION_EMAIL=appointment@dantkaya.com

# --------------------------------------------------------------------------
# 2. Optional Webhooks (CRM, Google Sheets / Apps Script, Slack)
# --------------------------------------------------------------------------
# Optional: Webhook URL to receive validated POST /api/appointments requests.
APPOINTMENT_WEBHOOK_URL=

# Optional: Webhook URL to receive validated POST /api/contact general enquiries.
CONTACT_WEBHOOK_URL=
